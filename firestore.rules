rules_version = '2';

// Firestore-Regeln für Bier Sammler.
// In der Firebase-Konsole unter Firestore Database → Regeln einfügen und veröffentlichen (siehe README.md).
//
// Datenmodell:
//   users/<uid>                  { username?, usernameKey? }
//   users/<uid>/drinks/<autoId>  { beerId: "BS-000001", at: <Millisekunden, Ganzzahl>, lat?, lng? }
//                                 (lat/lng: Ort des Eintrags für die Standort-Karte, nur wenn die Person es eingeschaltet hat)
//   usernames/<usernameKey>      { uid }
//   leaderboard/<uid>            { username, sum, count, cards }   (Rangliste: Punkte in Zehnteln, Anzahl Biere, verschiedene Karten)
//   sammlung/<uid>               { beers: { "<Bier-ID>": Anzahl } } (gesammelte Biere; in der Platzierung für andere sichtbar)
//
// Grundsatz: Jede Person liest und schreibt nur users/<eigene uid>/**. Ausnahmen sind einzelne Einträge
// in usernames (lesen für alle Angemeldeten), damit Namen eindeutig bleiben, und die Rangliste leaderboard
// (lesen für alle Angemeldeten, schreiben nur der Besitzer), ebenso die Sammlung sammlung.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function nameDoc(key) {
      return /databases/$(database)/documents/usernames/$(key);
    }
    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    // Name, den das Konto VOR diesem Schreibvorgang hatte (null, wenn keiner)
    function nameBefore(uid) {
      return exists(userDoc(uid)) ? get(userDoc(uid)).data.get('usernameKey', null) : null;
    }
    // Ein bisheriger Name, der nach dem Vorgang nicht mehr verwendet wird, muss im selben Vorgang freigegeben sein.
    // So kann niemand Namen horten oder einen Namen verwaist belegt lassen.
    function oldNameReleased(uid, newKey) {
      let before = nameBefore(uid);
      return before == null || before == newKey || !existsAfter(nameDoc(before));
    }

    match /users/{uid} {
      // Profil: entweder ohne Namen ({}) oder mit einem Namen, der im selben Schreibvorgang in
      // usernames/<usernameKey> für dieses Konto eingetragen ist (bzw. schon war).
      function validProfile(d) {
        return d.keys().hasOnly(['username', 'usernameKey'])
          && (
            (!('username' in d) && !('usernameKey' in d))
            || (d.username is string
              && d.usernameKey is string
              && d.usernameKey.matches('^[a-z0-9_]{3,20}$')
              && d.username.lower() == d.usernameKey
              && existsAfter(nameDoc(d.usernameKey))
              && getAfter(nameDoc(d.usernameKey)).data.uid == uid)
          )
          && oldNameReleased(uid, d.get('usernameKey', null));
      }

      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid) && oldNameReleased(uid, null);

      // STANDORT-KARTE: Ort ist optional, aber beide Werte zusammen und im gültigen Bereich.
      // (Zum Entfernen der Funktion: lat/lng aus hasOnly und diese Funktion samt Aufruf unten streichen; neue Einträge mit Ort würden dann abgelehnt.)
      function validPlace(d) {
        return (!('lat' in d) && !('lng' in d))
          || (d.lat is number && d.lng is number
            && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180);
      }

      // Trink-Protokoll: nur anlegen und löschen, nie ändern. Die Felder beerId und at, dazu optional lat und lng.
      // at darf nicht in der Zukunft liegen (5 Minuten Toleranz für ungenaue Geräteuhren). Eine Untergrenze gibt es
      // bewusst nicht: Einträge aus der Offline-Warteschlange kommen später mit ihrem ursprünglichen Zeitpunkt an.
      match /drinks/{drinkId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['beerId', 'at', 'lat', 'lng'])
          && request.resource.data.keys().hasAll(['beerId', 'at'])
          && validPlace(request.resource.data)
          && request.resource.data.beerId is string
          && request.resource.data.beerId.matches('^B[SM]-[0-9]{6}$')
          && request.resource.data.at is int
          && request.resource.data.at > 0
          && request.resource.data.at <= request.time.toMillis() + 5 * 60 * 1000;
        allow delete: if isOwner(uid);
      }
    }

    // Eindeutige Benutzernamen. Lesen dürfen alle Angemeldeten einzelne Einträge (nötig für „Name schon vergeben“);
    // eine Liste aller Namen (list) gibt es nicht. Die Rangliste liegt getrennt in leaderboard.
    match /usernames/{key} {
      allow get: if signedIn();

      // Anlegen nur, wenn der Name frei ist (create greift nur bei nicht vorhandenem Dokument; update gibt es nicht),
      // für das eigene Konto, im erlaubten Format, und nur zusammen mit users/<uid>.usernameKey == key.
      // Ein bisheriger anderer Name muss im selben Vorgang freigegeben werden (oldNameReleased).
      allow create: if signedIn()
        && key.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userDoc(request.auth.uid)).data.get('usernameKey', null) == key
        && oldNameReleased(request.auth.uid, key);

      // Freigeben nur durch den Besitzer
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Rangliste. Die App veröffentlicht hier Punkte, Anzahl Biere und Zahl der verschiedenen Karten (alles berechnet sie selbst aus dem Protokoll;
    // die Regeln können nicht nachzählen und prüfen deshalb nur, ob die Werte möglich sind). Es ist ein Spiel unter
    // Freunden, kein Wettbewerb mit Preisen. Lesen (get, list und Zählabfragen) dürfen alle Angemeldeten.
    // Schreiben nur für das eigene Dokument und nur mit Benutzernamen, der zum Profil passt.
    // sum steht in Zehnteln: je Bier 10 bis 35 (Stufe 1 bis 5 = 1,0 bis 2,5 Punkte, Spezialkarten bis 1,0 Extrapunkt; siehe js/game.js POINTS, MAX_BEER_POINTS),
    // dazu je Karte einmal 35 (3,5 Punkte für ein neues Bier; js/game.js NEW_CARD_BONUS). cards: 0 bis count, und mindestens 1, sobald es Biere gibt.
    // CHALLENGES (26.11.2026): sum enthält zusätzlich die Punkte geschaffter Challenges, je Challenge höchstens 40 (4,0 Punkte; js/game.js CHALLENGE_MAX_POINTS).
    // Spielraum nach oben (js/game.js challengeAllowance): (count + 2) × 40 (je Bier höchstens eine Challenge ohne Frist, dazu zwei als Reserve)
    // plus 40 je Woche seit dem 21.11.2026, 0:00 UTC (= 1795219200000 ms; eine Wochen-Challenge pro Woche). Ohne Division gerechnet:
    // (sum − Bierpunkte-Höchstwert − (count + 2) × 40) × 604800000 ≤ (jetzt − 1795219200000) × 40.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'sum', 'count', 'cards'])
        && request.resource.data.keys().hasAll(['username', 'sum', 'count', 'cards'])
        && request.resource.data.username is string
        && request.resource.data.count is int
        && request.resource.data.sum is int
        && request.resource.data.cards is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 1000000
        && request.resource.data.cards >= 0
        && request.resource.data.cards <= request.resource.data.count
        && (request.resource.data.cards > 0 || request.resource.data.count == 0)
        && request.resource.data.sum >= request.resource.data.count * 10 + request.resource.data.cards * 35
        && (request.resource.data.sum - request.resource.data.count * 35 - request.resource.data.cards * 35 - (request.resource.data.count + 2) * 40) * 604800000
             <= (request.time.toMillis() - 1795219200000) * 40
        && exists(userDoc(uid))
        && getAfter(userDoc(uid)).data.get('username', null) == request.resource.data.username;
      allow delete: if isOwner(uid);
    }

    // Sammlung (26.11.2026): welche Biere jemand wie oft getrunken hat, ohne Zeitpunkte und Orte. Die App zeigt sie in der
    // Platzierung beim Tipp auf einen fremden Namen. Lesen für alle Angemeldeten, schreiben nur der Besitzer. Die Regeln prüfen
    // nur die Form (eine Zuordnung, höchstens 20.000 Biere); die Anzahlen prüft die App beim Anzeigen (GAME.collectionList).
    match /sammlung/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['beers'])
        && request.resource.data.beers is map
        && request.resource.data.beers.size() <= 20000;
      allow delete: if isOwner(uid);
    }
  }
}
